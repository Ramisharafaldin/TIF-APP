# Flask Configuration
# Copy this file to .env and update with your values
# Example: cp .env.example .env

# ============================================
# SECURITY: Admin Password Setup (Task 1)
# ============================================
# ⚠️ IMPORTANT: NO HARDCODED DEFAULT PASSWORDS
# 
# On first run, a one-time setup token is generated automatically.
# The admin must visit: http://localhost:5000/setup?token=<TOKEN>
# and create their own secure password.
#
# The setup token is:
# - Logged to console on startup
# - Saved to setup_token.log for recovery
# - Valid for 24 hours only
# - Can only be used once
#
# This provides:
# ✓ No password in code
# ✓ No default credentials to change
# ✓ Secure one-time setup process
# ✓ Audit trail of setup attempts

# ============================================
# REQUIRED SETTINGS
# ============================================

# Secret key for session management and CSRF protection
# IMPORTANT: Generate a strong random string for production
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Flask environment (development or production)
# Options: development, production
FLASK_ENV=development

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Flask debug mode (True or False)
# WARNING: Never set to True in production
FLASK_DEBUG=True

# Application host
# Use 0.0.0.0 to allow external connections, or 127.0.0.1 for localhost only
FLASK_HOST=0.0.0.0

# Application port
FLASK_PORT=5000

# ============================================
# DATABASE — MongoDB (Phase 2–4, full cutover)
# ============================================

# MongoDB connection (external service 8.3.4+).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tif

# ============================================
# FILE UPLOAD SETTINGS
# ============================================

# Maximum file upload size in MB (default: 50)
# MAX_CONTENT_LENGTH_MB=50

# Upload folder path (default: uploads)
# UPLOAD_FOLDER=uploads

# ============================================
# GOOGLE GEMINI API SETTINGS
# ============================================

# Google Gemini API Key for AI features
# SECURITY: Replace with your actual API key from Google AI Studio
# Format: Should start with 'AIza' followed by alphanumeric characters
# Example: AIzaSyAUNTXg9cNKNiQI2qyifjLQ1gxBXc-QiDg
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini API Model Configuration
# Available models: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
# Recommended: gemini-2.0-flash-exp for best performance
GEMINI_MODEL_NAME=gemini-2.0-flash-exp

# API Connection Settings
# Timeout for API requests in seconds (recommended: 30-60)
GEMINI_TIMEOUT=30

# Maximum retry attempts for failed API calls (recommended: 3-5)
GEMINI_MAX_RETRIES=3

# Retry delay in seconds (exponential backoff base)
GEMINI_RETRY_DELAY=1.0

# Backoff multiplier for retry delays (recommended: 2.0)
GEMINI_BACKOFF_FACTOR=2.0

# ============================================
# AI CACHING AND PERFORMANCE
# ============================================

# Cache TTL for AI responses in seconds (default: 1 hour)
# Set to 0 to disable caching
GEMINI_CACHE_TTL=3600

# Maximum cache size in MB (default: 100MB)
AI_CACHE_MAX_SIZE_MB=100

# Enable response compression for large datasets
AI_ENABLE_COMPRESSION=true

# ============================================
# AI RATE LIMITING
# ============================================

# Rate limiting settings to prevent API quota exhaustion
# Requests per minute (adjust based on your API quota)
GEMINI_RATE_LIMIT_RPM=60

# Requests per day (adjust based on your API quota)
GEMINI_RATE_LIMIT_RPD=1000

# Burst limit for short-term spikes
GEMINI_BURST_LIMIT=10

# ============================================
# AI FEATURE TOGGLES
# ============================================

# Master switch for all AI features
# Set to false to disable all AI functionality
AI_FEATURES_ENABLED=true

# Individual feature toggles
# Natural language query interface
AI_NATURAL_LANGUAGE_ENABLED=true

# AI-enhanced smart reports
AI_SMART_REPORTS_ENABLED=true

# AI-powered forecasting enhancements
AI_ENHANCED_FORECASTING_ENABLED=true

# AI insights on dashboard
AI_DASHBOARD_INSIGHTS_ENABLED=true

# ============================================
# AI SECURITY AND PRIVACY
# ============================================

# Data anonymization settings
# Mask sensitive data before sending to AI service
AI_MASK_SENSITIVE_DATA=true

# Enable audit logging for AI API calls
AI_LOG_API_CALLS=true

# Enable comprehensive audit trail
AI_AUDIT_ENABLED=true

# Data retention period for AI responses (days)
AI_DATA_RETENTION_DAYS=30

# Automatically purge old AI cache entries
AI_AUTO_PURGE_CACHE=true

# ============================================
# AI DEVELOPMENT AND DEBUGGING
# ============================================

# Enable detailed AI service logging (development only)
# WARNING: May log sensitive data - disable in production
AI_DEBUG_LOGGING=false

# Enable AI performance monitoring
AI_PERFORMANCE_MONITORING=true

# Log AI response times and metrics
AI_LOG_PERFORMANCE_METRICS=true

# Enable circuit breaker for API resilience
AI_CIRCUIT_BREAKER_ENABLED=true

# Circuit breaker failure threshold (number of failures before opening)
AI_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker recovery timeout in seconds
AI_CIRCUIT_BREAKER_TIMEOUT=60

# ============================================
# ENVIRONMENT-SPECIFIC AI SETTINGS
# ============================================

# Development environment settings
# Use lower rate limits and shorter timeouts for testing
# DEV_GEMINI_TIMEOUT=15
# DEV_GEMINI_RATE_LIMIT_RPM=30

# ============================================
# FIELD-LEVEL ENCRYPTION (at-rest)
# ============================================
# Encryption key for field-level encryption of PII/confidential data
# (Fernet key). Generate via: python setup_encryption.py --init
# Never commit this value; .env is gitignored. If unset, the app falls
# back to the .db_key file generated by the same setup command.
# DB_ENCRYPTION_KEY=

# Production environment settings
# Use higher timeouts and rate limits for production workloads
# PROD_GEMINI_TIMEOUT=60
# PROD_GEMINI_RATE_LIMIT_RPM=100

# ============================================
# AI CONTENT FILTERING
# ============================================

# Enable content safety filtering
AI_CONTENT_SAFETY_ENABLED=true

# Content safety threshold (LOW, MEDIUM, HIGH)
AI_CONTENT_SAFETY_THRESHOLD=MEDIUM

# Block potentially harmful content
AI_BLOCK_HARMFUL_CONTENT=true

# ============================================
# AI PROVIDER ABSTRACTION (Phase 3, §4.4)
# ============================================
# Selects which AI provider backs the service. Existing GEMINI_* vars are
# kept for backward compatibility. Options:
#   gemini | ollama | lmstudio | openrouter | openai | azure_openai | custom
AI_PROVIDER=gemini

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- LM Studio (local OpenAI-compatible) ---
LMSTUDIO_ENDPOINT=http://localhost:1234/v1
LMSTUDIO_MODEL=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=TIF-AI

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Custom OpenAI-compatible endpoint (vLLM, etc.) ---
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Existing Gemini vars (unchanged) are kept above under
# "GOOGLE GEMINI API SETTINGS".
